    "@electron-forge/shared-types": "^8.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.4.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.17.0"
